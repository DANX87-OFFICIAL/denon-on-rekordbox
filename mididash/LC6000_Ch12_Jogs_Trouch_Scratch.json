    {
      "class": "script",
      "error": null,
      "height": 73,
      "id": "Script 1",
      "in_ports": [
        {
          "id": "*",
          "name": "*"
        }
      ],
      "name": "Basic",
      "out_ports": [
        {
          "id": "out",
          "name": "out"
        }
      ],
      "script": "local out_bytes = {}\n\n-- Copy the message so the incoming bytes remain unchanged\nfor i, byte in ipairs(bytes) do\n  out_bytes[i] = byte\nend\n\nlocal status = bytes[1]\nlocal cc = bytes[2]\nlocal input = bytes[3]\n\n--log(cc)\n-- log(input)\n\n-- 0xB0–0xBF are Control Change messages on channels 1–16\nif status >= 0xB0 and status <= 0xBF and cc == 34 then\n  local output\n\n  if input == 0 then\n  \toutput = 0\n  elseif input < 64 then\n    -- Forward: 1-63 dec\n    -- slow to fast\n    output = 64 + input\n  \t-- bend = 0.25\n   -- t = (input - 1) / 64.0 \n   -- output = 64 + 64 * math.pow(t, bend)\n  else  -- input > 64\n  \t--- Reverse: 127-64 dec\n  \t--- slow to fast\n    output = input-64\n    -- bend = 2.0\n    -- t = (input - 1) / 64.0 \n    -- output = 64 + 64 * math.pow(t, bend)\n  end\n  -- MIDI CC values must be in the range 0–127.\n  -- The formula gives -1 when input is 65, so clamp that case to 0.\n  if output < 0 then\n    output = 0\n  end\n  if output > 127 then\n    output = 127\n  end\n  out_bytes[3] = output\n---else:\n---\tend\nend\n\n-- Hardcode DT1 for DDJ-SX:\n-- 34d = 0x22\nout_bytes[2] = 33\n\nlog(out_bytes[3])\n\ntable.insert(res, {\n  port = \"out\",\n  bytes = out_bytes\n})\n",
      "test_bytes": "0xb0 34 65",
      "width": 102,
      "x": 385.1276026562458,
      "y": -145.63008838113484
    },
